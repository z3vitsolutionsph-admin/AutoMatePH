rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // --- PRIMITIVES ---
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Bootstrapped Admin: Your user email is given admin role for testing.
    function isSuperAdmin() {
      return isSignedIn() && (
        ("email" in request.auth.token && request.auth.token.email in ["z3vitsolutions.ph@gmail.com"]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "SUPER_ADMIN")
      );
    }
    
    function isStoreManager() {
      return isSignedIn() && (
        ("email" in request.auth.token && request.auth.token.email in ["z3vitsolutions.ph@gmail.com"]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["STORE_MANAGER", "SUPER_ADMIN"])
      );
    }
    
    function isInventoryClerkOrHigher() {
      return isSignedIn() && (
        ("email" in request.auth.token && request.auth.token.email in ["z3vitsolutions.ph@gmail.com"]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["INVENTORY_CLERK", "STORE_MANAGER", "SUPER_ADMIN"])
      );
    }
    
    function isCashierOrHigher() {
      return isSignedIn() && (
        ("email" in request.auth.token && request.auth.token.email in ["z3vitsolutions.ph@gmail.com"]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["CASHIER", "STORE_MANAGER", "SUPER_ADMIN"])
      );
    }

    // --- VALIDATION HELPERS (Anti-Update-Gap) ---
    
    function isValidUser(data) {
      return data.keys().hasAll(["email", "name", "role", "createdAt", "updatedAt", "isActive"])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.role in ["SUPER_ADMIN", "STORE_MANAGER", "CASHIER", "INVENTORY_CLERK"]
        && (data.get('pin', '') is string) // optional or strictly string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.isActive is bool;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(["barcode", "name", "price", "cost", "stock", "createdAt", "updatedAt"])
        && data.barcode is string && data.barcode.size() > 0 && data.barcode.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && data.cost is number && data.cost >= 0
        && data.stock is number && data.stock >= 0
        && (data.get('minStock', 0) is number)
        && (data.get('category', '') is string)
        && (data.get('description', '') is string)
        && (data.get('imageUrl', '') is string)
        && (data.get('supplierId', '') is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(["totalAmount", "paymentMethod", "cashierId", "items", "status", "createdAt", "updatedAt"])
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paymentMethod in ["CASH", "CARD", "E_WALLET"]
        && data.cashierId is string
        && data.items is list && data.items.size() > 0 && data.items.size() <= 500
        && data.status in ["COMPLETED", "VOIDED"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(["type", "userId", "details", "timestamp"])
        && data.type in ["STOCK_ADJUSTMENT", "SALE", "INBOUND_DELIVERY", "PURCHASE_ORDER"]
        && data.userId is string
        && data.details is string && data.details.size() <= 1000
        && data.timestamp is timestamp;
    }

    function isValidPurchaseOrder(data) {
      return data.keys().hasAll(["supplierName", "orderDate", "expectedDeliveryDate", "items", "status", "createdBy", "totalAmount", "createdAt", "updatedAt"])
        && data.supplierName is string && data.supplierName.size() > 0 && data.supplierName.size() <= 200
        && (data.get('supplierContact', '') is string)
        && data.orderDate is string && data.orderDate.size() <= 50
        && data.expectedDeliveryDate is string && data.expectedDeliveryDate.size() <= 50
        && data.items is list && data.items.size() > 0 && data.items.size() <= 200
        && data.status in ["PENDING", "DELIVERED", "CANCELLED"]
        && data.createdBy is string
        && data.totalAmount is number && data.totalAmount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    
    function isValidSupplier(data) {
      return data.keys().hasAll(["name", "createdAt", "updatedAt"])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (data.get('contact', '') is string) && data.get('contact', '').size() <= 100
        && (data.get('address', '') is string) && data.get('address', '').size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPromotion(data) {
      return data.keys().hasAll(["name", "type", "value", "targetType", "active", "createdAt", "updatedAt"])
        && (data.get('code', '') is string) && data.get('code', '').size() <= 50
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.type in ["PERCENTAGE", "FIXED", "BOGO"]
        && data.value is number && data.value >= 0
        && data.targetType in ["ORDER", "PRODUCT", "CATEGORY"]
        && (data.get('targetIds', []) is list)
        && (data.get('startDate', '') is string)
        && (data.get('endDate', '') is string)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- COLLECTIONS ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || isStoreManager());
      allow list: if isSignedIn() && isSuperAdmin(); // Prevent PII Blanket Read
      
      allow create: if (isSuperAdmin() || request.auth.uid == userId) 
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if (isSuperAdmin() || (request.auth.uid == userId && incoming().role == existing().role && incoming().isActive == existing().isActive))
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin() || 
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'pin', 'updatedAt'])
        );
        
      allow delete: if isSuperAdmin();
    }

    match /products/{productId} {
      allow get: if isCashierOrHigher() || isInventoryClerkOrHigher();
      allow list: if isCashierOrHigher() || isInventoryClerkOrHigher();
      
      allow create: if isStoreManager() || isInventoryClerkOrHigher()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if (isStoreManager() || isInventoryClerkOrHigher() && 
          incoming().diff(existing()).affectedKeys().hasOnly([
            'barcode', 'name', 'price', 'cost', 'stock', 'minStock', 
            'category', 'description', 'imageUrl', 'supplierId', 'updatedAt'
          ])
        ) || (isCashierOrHigher() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
        )
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
        
      allow delete: if isSuperAdmin();
    }

    match /transactions/{transactionId} {
      allow get: if isStoreManager() || (isCashierOrHigher() && existing().cashierId == request.auth.uid);
      allow list: if isStoreManager() || (isCashierOrHigher() && resource.data.cashierId == request.auth.uid);
      
      allow create: if isCashierOrHigher()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().cashierId == request.auth.uid 
        && exists(/databases/$(database)/documents/users/$(incoming().cashierId)) // No orphaned writes
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isSuperAdmin() // Only admins can modify transactions
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'VOIDED' // Terminal State Guard
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
        
      allow delete: if isSuperAdmin(); // Super admin can clear transactions.
    }

    match /activityLogs/{logId} {
      allow get: if isStoreManager();
      allow list: if isStoreManager();
      
      allow create: if isCashierOrHigher()
        && isValidId(logId)
        && isValidActivityLog(incoming())
        && incoming().timestamp == request.time;
        
      allow update: if false; // Immutable
      allow delete: if isStoreManager(); // Allow store managers and admins to clear logs
    }

    match /purchaseOrders/{orderId} {
      allow get: if isStoreManager();
      allow list: if isStoreManager();
      
      allow create: if isStoreManager()
        && isValidId(orderId)
        && isValidPurchaseOrder(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isStoreManager()
        && isValidId(orderId)
        && isValidPurchaseOrder(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'PENDING'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'expectedDeliveryDate']);
        
      allow delete: if false;
    }
    match /suppliers/{supplierId} {
      allow get: if isCashierOrHigher();
      allow list: if isCashierOrHigher();
      
      allow create: if isStoreManager()
        && isValidId(supplierId)
        && isValidSupplier(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isStoreManager()
        && isValidId(supplierId)
        && isValidSupplier(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'contact', 'address', 'updatedAt']);
        
      allow delete: if isSuperAdmin();
    }

    match /promotions/{promotionId} {
      allow get: if isCashierOrHigher();
      allow list: if isCashierOrHigher();
      
      allow create: if isStoreManager()
        && isValidId(promotionId)
        && isValidPromotion(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isStoreManager()
        && isValidId(promotionId)
        && isValidPromotion(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'name', 'type', 'value', 'targetType', 'targetIds', 
          'startDate', 'endDate', 'active', 'updatedAt'
        ]);
        
      allow delete: if isSuperAdmin();
    }
  }
}
